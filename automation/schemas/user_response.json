{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UserResponse",
  "type": "object",
  "required": [
    "id",
    "username",
    "email",
    "role",
    "active"
  ],
  "properties": {
    "id": {
      "type": "integer"
    },
    "username": {
      "type": "string"
    },
    "email": {
      "type": "string",
      "format": "email"
    },
    "role": {
      "type": "string"
    },
    "active": {
      "type": "boolean"
    }
  },
  "additionalProperties": false
}